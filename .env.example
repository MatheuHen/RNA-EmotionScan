# Expressao Neural - variaveis de ambiente OPCIONAIS
#
# Este projeto NAO usa credenciais, chaves de API nem servicos externos.
# As variaveis abaixo existem apenas para desenvolvimento e testes.
# Copie para .env apenas se precisar; .env nao e versionado.

# Ativa mensagens de diagnostico adicionais (1 para ligar).
EXPRESSAO_NEURAL_DEBUG=0

# Impede que testes e scripts sobrescrevam config.local.json (1 para ligar).
EXPRESSAO_NEURAL_SEM_PERSISTENCIA=0

# Duracao, em minutos, do teste de execucao prolongada.
EXPRESSAO_NEURAL_DURACAO_MIN=2
